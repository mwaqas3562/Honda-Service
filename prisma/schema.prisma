generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────

enum StockLogType {
  purchase
  sale
  service
  adjustment
}

enum PurchaseStatus {
  ordered
  in_transit
  received
}

enum PaymentType {
  cash
  card
  credit
  online
}

enum SaleStatus {
  draft
  final
}

enum SaleType {
  sale
  quick_service
}

enum ServiceType {
  oil_change
  engine_tune_up
  brake_service
  chain_adjustment
  full_service
  clutch_replacement
  electrical_repair
  body_work
  other
}

enum ServiceStatus {
  pending
  in_progress
  completed
}

enum JobCardStatus {
  open
  completed
}

enum StaffRole {
  job_card_person
  mechanic
  store_keeper
  admin
  wheel_balancer
}

enum StaffStatus {
  active
  inactive
}

enum BonusType {
  flat
  percentage
}

enum AttendanceStatus {
  present
  absent
}

enum ExpenseType {
  food
  utility
  misc
}

enum AdminRole {
  ADMIN
}

// ─── Categories ──────────────────────────────────

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  subcategories Subcategory[]
  parts         Part[]
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("categories")
}

model Subcategory {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parts      Part[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([categoryId, name])
  @@map("subcategories")
}

// ─── Vendors ─────────────────────────────────────

model Vendor {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  purchases Purchase[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("vendors")
}

// ─── Parts ───────────────────────────────────────

model Part {
  id            Int           @id @default(autoincrement())
  name          String
  partNumber    String        @unique @map("part_number")
  categoryId    Int?          @map("category_id")
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId Int?          @map("subcategory_id")
  subcategory   Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  purchasePrice Decimal       @default(0) @map("purchase_price") @db.Decimal(12,2)
  salePrice     Decimal       @default(0) @map("sale_price") @db.Decimal(12,2)
  stock         Int           @default(0)
  minStock      Int           @default(5) @map("min_stock")
  aliases       String[]      @default([])
  usageCount    Int           @default(0) @map("usage_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  stockLogs     StockLog[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  serviceItems  ServiceItem[]

  @@index([name])
  @@index([categoryId])
  @@map("parts")
}

// ─── Stock Logs ──────────────────────────────────

model StockLog {
  id            Int      @id @default(autoincrement())
  partId        Int      @map("part_id")
  part          Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  type          StockLogType
  quantity      Int
  prevStock     Int      @map("prev_stock")
  newStock      Int      @map("new_stock")
  purchasePrice Decimal? @map("purchase_price") @db.Decimal(12,2)
  prevPrice     Decimal? @map("prev_price") @db.Decimal(12,2)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([partId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_logs")
}

// ─── Purchases ───────────────────────────────────

model Purchase {
  id        Int            @id @default(autoincrement())
  vendorId  Int            @map("vendor_id")
  vendor    Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status    PurchaseStatus @default(ordered)
  total     Decimal        @default(0) @db.Decimal(12,2)
  note      String?
  items     PurchaseItem[]
  deletedAt DateTime?      @map("deleted_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([vendorId])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int      @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  partId     Int      @map("part_id")
  part       Part     @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12,2)
  total      Decimal  @db.Decimal(12,2)

  @@index([purchaseId])
  @@index([partId])
  @@map("purchase_items")
}

// ─── Labour Master ───────────────────────────────

model Labour {
  id           Int              @id @default(autoincrement())
  name         String
  defaultPrice Decimal          @default(0) @map("default_price") @db.Decimal(12,2)
  notes        String?
  saleLabours  SaleLabourItem[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([name])
  @@map("labours")
}

// ─── Sales ───────────────────────────────────────

model Sale {
  id          Int              @id @default(autoincrement())
  saleType    SaleType         @default(sale) @map("sale_type")
  jobCardId   Int?             @map("job_card_id")
  jobCard     JobCard?         @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  staffId     Int?             @map("staff_id")
  staff       Staff?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  customer    String?
  bikeNumber  String?          @map("bike_number")
  phone       String?
  date        DateTime         @default(now())
  laborCost   Decimal          @default(0) @map("labor_cost") @db.Decimal(12,2)
  subtotal    Decimal          @default(0) @db.Decimal(12,2)
  discount    Decimal          @default(0) @db.Decimal(12,2)
  total       Decimal          @default(0) @db.Decimal(12,2)
  paymentType PaymentType      @default(cash) @map("payment_type")
  status      SaleStatus       @default(draft)
  finalizedAt DateTime?        @map("finalized_at")
  items       SaleItem[]
  labourItems SaleLabourItem[]
  bonusLogs   StaffBonusLog[]
  wbSaleLog   WheelBalancerSaleLog?
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([jobCardId])
  @@index([staffId])
  @@index([date])
  @@index([createdAt])
  @@index([status])
  @@index([saleType])
  @@map("sales")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  partId    Int     @map("part_id")
  part      Part    @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12,2)
  total     Decimal @db.Decimal(12,2)

  @@index([saleId])
  @@index([partId])
  @@map("sale_items")
}

model SaleLabourItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  labourId  Int     @map("labour_id")
  labour    Labour  @relation(fields: [labourId], references: [id], onDelete: Restrict)
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(12,2)
  total     Decimal @db.Decimal(12,2)

  @@index([saleId])
  @@index([labourId])
  @@map("sale_labour_items")
}

// ─── Services ────────────────────────────────────

model Service {
  id            Int           @id @default(autoincrement())
  jobCardId     Int?          @map("job_card_id")
  jobCard       JobCard?      @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  customerName  String        @map("customer_name")
  customerPhone String?       @map("customer_phone")
  bikeModel     String        @map("bike_model")
  bikeRegNo     String?       @map("bike_reg_no")
  serviceType   ServiceType   @map("service_type")
  status        ServiceStatus @default(pending)
  laborCost     Decimal       @default(0) @map("labor_cost") @db.Decimal(12,2)
  total         Decimal       @default(0) @db.Decimal(12,2)
  note          String?
  items         ServiceItem[]
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([jobCardId])
  @@map("services")
}

model ServiceItem {
  id        Int     @id @default(autoincrement())
  serviceId Int     @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  partId    Int     @map("part_id")
  part      Part    @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12,2)
  total     Decimal @db.Decimal(12,2)

  @@index([serviceId])
  @@index([partId])
  @@map("service_items")
}

// ─── Job Cards ───────────────────────────────────

model JobCard {
  id             Int      @id @default(autoincrement())
  jobCardNumber  String   @unique @map("job_card_number")
  customerName   String   @map("customer_name")
  customerPhone  String   @map("customer_phone")
  vehicleNumber  String   @map("vehicle_number")
  meterReading   Int      @map("meter_reading")
  bikeModel      String   @map("bike_model")
  laborCost      Decimal  @default(0) @map("labor_cost") @db.Decimal(12,2)
  status         JobCardStatus @default(open)
  sales          Sale[]
  services       Service[]
  staffAssignments JobCardStaff[]
  bonusLogs      StaffBonusLog[]
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([jobCardNumber])
  @@index([customerPhone])
  @@index([vehicleNumber])
  @@index([status])
  @@map("job_cards")
}

// ─── Staff ───────────────────────────────────────

model Staff {
  id         Int      @id @default(autoincrement())
  name       String
  role       StaffRole
  contact    String?
  status     StaffStatus @default(active)
  baseSalary Decimal  @default(0) @map("base_salary") @db.Decimal(12,2)
  jobCardAssignments JobCardStaff[]
  sales        Sale[]
  bonusConfig  StaffBonusConfig?
  bonusLogs    StaffBonusLog[]
  wbConfig     WheelBalancerConfig?
  wbPerformance WheelBalancerPerformance[]
  wbSaleLogs   WheelBalancerSaleLog[]
  attendance   StaffAttendance[]
  advances     StaffAdvance[]
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@index([name])
  @@map("staff")
}

// ─── Job Card Staff Assignments ──────────────────

model JobCardStaff {
  id         Int      @id @default(autoincrement())
  jobCardId  Int      @map("job_card_id")
  jobCard    JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  staffId    Int      @map("staff_id")
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  labourType String?  @map("labour_type")
  hoursSpent Decimal? @map("hours_spent") @db.Decimal(6,2)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([jobCardId, staffId])
  @@index([jobCardId])
  @@index([staffId])
  @@map("jobcard_staff")
}

// ─── Staff Bonus Configuration ───────────────────

model StaffBonusConfig {
  id              Int      @id @default(autoincrement())
  staffId         Int      @unique @map("staff_id")
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  minJobcardAmount Decimal @map("min_jobcard_amount") @db.Decimal(12,2)
  bonusType       BonusType @map("bonus_type")
  bonusValue      Decimal   @map("bonus_value") @db.Decimal(12,2)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("staff_bonus_config")
}

// ─── Staff Bonus Log ─────────────────────────────

model StaffBonusLog {
  id            Int      @id @default(autoincrement())
  staffId       Int      @map("staff_id")
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  jobCardId     Int?     @map("job_card_id")
  jobCard       JobCard? @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  saleId        Int?     @map("sale_id")
  sale          Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  jobCardAmount Decimal  @map("job_card_amount") @db.Decimal(12,2)
  bonusAmount   Decimal  @map("bonus_amount") @db.Decimal(12,2)
  bonusType     BonusType @map("bonus_type")
  bonusValue    Decimal   @map("bonus_value") @db.Decimal(12,2)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([staffId, jobCardId])
  @@unique([staffId, saleId])
  @@index([staffId])
  @@index([jobCardId])
  @@index([saleId])
  @@index([createdAt])
  @@map("staff_bonus_log")
}

// ─── Wheel Balancer System ───────────────────────

model WheelBalancerConfig {
  id              Int      @id @default(autoincrement())
  staffId         Int      @unique @map("staff_id")
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  bonusThreshold  Int      @default(100) @map("bonus_threshold")
  bonusType       BonusType @default(flat) @map("bonus_type")
  bonusValue      Decimal  @default(0) @map("bonus_value") @db.Decimal(12,2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("wheel_balancer_config")
}

model WheelBalancerPerformance {
  id              Int      @id @default(autoincrement())
  staffId         Int      @map("staff_id")
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month           String   // "2026-03" format
  serviceCount    Int      @default(0) @map("service_count")
  totalEarnings   Decimal  @default(0) @map("total_earnings") @db.Decimal(12,2)
  bonusAmount     Decimal  @default(0) @map("bonus_amount") @db.Decimal(12,2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([staffId, month])
  @@index([staffId])
  @@index([month])
  @@map("wheel_balancer_performance")
}

model WheelBalancerSaleLog {
  id        Int      @id @default(autoincrement())
  saleId    Int      @unique @map("sale_id")
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staffId   Int      @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12,2)
  count     Int      @default(1)
  month     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([staffId])
  @@index([month])
  @@map("wheel_balancer_sale_log")
}

// ─── Daily Cash Report ───────────────────────────

model DailyCashReport {
  id                Int      @id @default(autoincrement())
  date              DateTime @unique @db.Date
  advanceSalary     Decimal  @default(0) @map("advance_salary") @db.Decimal(12,2)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("daily_cash_reports")
}

// ─── Staff Attendance ─────────────────────────────

model StaffAttendance {
  id        Int      @id @default(autoincrement())
  staffId   Int      @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  status    AttendanceStatus
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
  @@map("staff_attendance")
}

// ─── Staff Advance ───────────────────────────────

model StaffAdvance {
  id        Int      @id @default(autoincrement())
  staffId   Int      @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12,2)
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([staffId])
  @@index([date])
  @@map("staff_advances")
}

// ─── Salary Lock ─────────────────────────────────

model SalaryLock {
  id        Int      @id @default(autoincrement())
  month     String   @unique // "2026-03" format
  lockedAt  DateTime @default(now()) @map("locked_at")

  @@map("salary_locks")
}

// ─── Expenses ────────────────────────────────────

model Expense {
  id        Int      @id @default(autoincrement())
  amount    Decimal  @db.Decimal(12,2)
  type      ExpenseType
  note      String?
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([type])
  @@map("expenses")
}

// ─── Reminder System ─────────────────────────────

enum ReminderChannel {
  whatsapp
  sms
}

enum ReminderStatus {
  sent
  delivered
  read
  failed
  ignored
}

enum ReminderType {
  engine_tuning
  oil_change
  missed_visit
  comeback
  custom
}

model ReminderLog {
  id              Int             @id @default(autoincrement())
  customerPhone   String          @map("customer_phone")
  customerName    String          @map("customer_name")
  bikeNumber      String?         @map("bike_number")
  bikeModel       String?         @map("bike_model")
  messageType     ReminderType    @map("message_type")
  channel         ReminderChannel
  status          ReminderStatus  @default(sent)
  priority        Int             @default(0)
  messageContent  String          @map("message_content")
  twilioSid       String?         @map("twilio_sid")
  errorMessage    String?         @map("error_message")
  sentAt          DateTime        @default(now()) @map("sent_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([customerPhone])
  @@index([messageType])
  @@index([sentAt])
  @@index([status])
  @@map("reminder_logs")
}

model ReminderConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reminder_config")
}

// ─── Admin Users ─────────────────────────────────

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // bcrypt hash
  name      String
  role      AdminRole @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}
